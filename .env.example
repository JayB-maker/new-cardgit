# Demo form endpoint. Leave empty until the backend endpoint is ready.
NEXT_PUBLIC_DEMO_ENDPOINT=

# Pricing values are read by the dynamic /pricing route.
# Nigeria visitors are detected through request country headers and shown NGN.
CARDGIT_PRICE_PREMIUM_MONTHLY_NGN=8500
CARDGIT_PRICE_PREMIUM_ANNUAL_NGN=7200
CARDGIT_PRICE_TEAM_MONTHLY_NGN=20000
CARDGIT_PRICE_TEAM_ANNUAL_NGN=17000

# Visitors outside Nigeria default to GBP.
CARDGIT_PRICE_PREMIUM_MONTHLY_GBP=5.10
CARDGIT_PRICE_PREMIUM_ANNUAL_GBP=4.35
CARDGIT_PRICE_TEAM_MONTHLY_GBP=12
CARDGIT_PRICE_TEAM_ANNUAL_GBP=10
