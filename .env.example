# CardGit backend API used by local API proxy routes.
CARDGIT_API_BASE_URL=https://redesignedcardgitapi.onrender.com

# Public CardGit app URL used for promoted card share links.
NEXT_PUBLIC_CARDGIT_APP_BASE_URL=https://redesignedcardgit.onrender.com

# Pricing values are read by the dynamic /pricing route.
# GBP is the default display currency and can be changed here.
CARDGIT_PRICE_CURRENCY_CODE=GBP
CARDGIT_PRICE_CURRENCY_SYMBOL=£
CARDGIT_PRICE_CURRENCY_LOCALE=en-GB
CARDGIT_PRICE_PREMIUM_MONTHLY=5.10
CARDGIT_PRICE_PREMIUM_ANNUAL=4.35
CARDGIT_PRICE_PREMIUM_ANNUAL_DISCOUNT_PERCENT=14.7
CARDGIT_PRICE_TEAM_MONTHLY=12
CARDGIT_PRICE_TEAM_ANNUAL=10
CARDGIT_PRICE_TEAM_ANNUAL_DISCOUNT_PERCENT=16.7
